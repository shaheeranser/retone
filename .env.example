# Copy this file to .env for local runs. .env is gitignored; never commit it.
# Hugging Face write token (create at huggingface.co/settings/tokens).
HF_TOKEN=hf_replace_me

# Private dataset produced by `python -m retone.train.upload_dataset`.
DATASET_REPO=your-username/retone-dataset

# Model repo for the LoRA adapter; the merged model goes to OUTPUT_REPO-merged.
OUTPUT_REPO=your-username/retone-qwen

# Optional overrides for the gate.
MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# WORK_DIR=/content/retone-remote
